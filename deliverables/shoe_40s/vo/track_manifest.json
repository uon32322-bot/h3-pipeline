 "sentences": [
  {
   "key": "s1_hook",
   "seg": "①",
   "text": "你脚上那双跑鞋，可能选错了。",
   "chars": 12,
   "start": 0.4,
   "end": 2.906,
   "dur": 2.506,
   "cps": 4.79
  },
  {
   "key": "s2_pain",
   "seg": "②",
   "text": "早上挤地铁，晚上还要举铁，一双鞋从早穿到晚，脚底板发麻、后跟发酸。",
   "chars": 28,
   "start": 3.452,
   "end": 9.733,
   "dur": 6.281,
   "cps": 4.46
  },
  {
   "key": "s3a_proof",
   "seg": "③",
   "text": "这双鞋拿贾卡网布做鞋面，透气孔密到能看见光；中底压了三层泡棉，落地那一下先软后弹。",
   "chars": 37,
   "start": 10.279,
   "end": 17.934,
   "dur": 7.655,
   "cps": 4.83
  },
  {
   "key": "s3b_hook2",
   "seg": "③",
   "text": "把它翻过来看：缓震层叠了三道，后跟还收了一道弧；跑起来脚踝不容易往外翻。",
   "chars": 32,
   "start": 18.479,
   "end": 24.954,
   "dur": 6.475,
   "cps": 4.94
  },
  {
   "key": "s4_trust",
   "seg": "④",
   "text": "说实话它不算轻，单只接近三百克；但正是这份分量，让你跑到最后两公里还站得稳。",
   "chars": 34,
   "start": 25.5,
   "end": 32.287,
   "dur": 6.787,
   "cps": 5.01
  },
  {
   "key": "s5_cta",
   "seg": "⑤",
   "text": "现在下单，两色可选，尺码从三六到四六；不满意七天可退。点下方小黄车。",
   "chars": 29,
   "start": 32.833,
   "end": 39.4,
   "dur": 6.567,
   "cps": 4.42
  }
